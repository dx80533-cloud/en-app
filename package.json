{
  "name": "vocab-party-selfhosted",
  "version": "1.0.0",
  "private": true,
  "description": "字庫派對 - GEPT/多益/雅思單字複習 App（自架版：NestJS + SQLite + React + Vite）",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nest start --watch",
    "dev:client": "NODE_ENV=development vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "NODE_ENV=production tsc -p tsconfig.node.json",
    "build:client": "NODE_ENV=production vite build --config vite.config.ts",
    "start": "NODE_ENV=production node dist/server/main.js",
    "start:dev": "NODE_ENV=development node dist/server/main.js",
    "type:check": "npm run type:check:server && npm run type:check:client",
    "type:check:server": "tsc --noEmit -p tsconfig.node.json",
    "type:check:client": "tsc --noEmit -p tsconfig.app.json",
    "eslint": "eslint . --quiet"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.20",
    "axios": "^1.12.2",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.44.6",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
